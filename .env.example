# Copier ce fichier vers .env et adapter localement.
# Aucun secret ici — .env est ignoré par git (voir .gitignore).

# Environnement d'exécution : development | production | test
APP_ENV=development

# Niveau de journalisation : DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Hôte / port du serveur API
API_HOST=127.0.0.1
API_PORT=8000

# Origines autorisées pour les appels du frontend (CORS), séparées par des virgules.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Répertoire de travail pour les jobs (audio, résultats, etc.)
# Les fichiers audio importés sont stockés dans <DATA_DIR>/uploads/.
DATA_DIR=./data

# Taille maximale (en Mo) acceptée pour un fichier audio importé.
MAX_UPLOAD_SIZE_MB=100

# Nombre de jobs de traitement exécutés en parallèle.
# Valeur par défaut prudente (voir docs/TECHNICAL_DECISIONS.md, D6) :
# TensorFlow/PyTorch ont une empreinte mémoire significative sur machine modeste.
JOB_CONCURRENCY=1

# Active la récupération audio depuis une URL YouTube via yt-dlp.
# Décision Q1 (docs/TECHNICAL_DECISIONS.md) : usage personnel, sous la responsabilité
# de l'utilisateur final.
YTDLP_ENABLED=true

# Durée maximale (en secondes) d'une vidéo YouTube acceptée pour l'import.
YOUTUBE_MAX_DURATION_SECONDS=900

# Temps maximal (en secondes) accordé à l'ensemble de l'opération
# (métadonnées + téléchargement + extraction audio) avant abandon.
YOUTUBE_DOWNLOAD_TIMEOUT_SECONDS=120

# Séparation d'instruments (Demucs — dépendance OPTIONNELLE, voir
# docs/MODELS.md pour l'installation et les questions de licence).
# Mémoire disponible minimale (Mo) exigée avant de démarrer une séparation.
SEPARATION_MIN_AVAILABLE_MEMORY_MB=1500
# Délai maximal (secondes) avant qu'une séparation en cours soit signalée en timeout.
SEPARATION_TIMEOUT_SECONDS=900
# Autorise Demucs à télécharger un modèle non encore mis en cache.
SEPARATION_ALLOW_MODEL_DOWNLOAD=true

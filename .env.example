# Copier ce fichier vers .env et adapter localement.
# Aucun secret ici — .env est ignoré par git (voir .gitignore).

# Environnement d'exécution : development | production | test
APP_ENV=development

# Niveau de journalisation : DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Hôte / port du serveur API
API_HOST=127.0.0.1
API_PORT=8000

# Répertoire de travail pour les jobs (audio, résultats, etc.)
DATA_DIR=./data

# Nombre de jobs de traitement exécutés en parallèle.
# Valeur par défaut prudente (voir docs/TECHNICAL_DECISIONS.md, D6) :
# TensorFlow/PyTorch ont une empreinte mémoire significative sur machine modeste.
JOB_CONCURRENCY=1

# Active la récupération audio depuis une URL YouTube via yt-dlp.
# Décision Q1 (docs/TECHNICAL_DECISIONS.md) : usage personnel, sous la responsabilité
# de l'utilisateur final. Fonctionnalité non encore implémentée à ce stade (Étape 2).
YTDLP_ENABLED=true
